{
  "name": "omni-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial browser extension for Omni / Academy TOP teachers: schedule, lessons, students, homework and teaching materials.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anen135/omni-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/Anen135/omni-workspace/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build --mode pages",
    "build:extension": "tsc && node extension/build.mjs",
    "test:extension-ui": "node tests/extension-browser.mjs",
    "test:workspace-ui": "node tests/workspace-browser.mjs",
    "desktop:build": "node desktop/build-agent.mjs && dotnet build desktop/Omni.Desktop.csproj -c Release",
    "desktop:dev": "desktop\\bin\\Release\\net48\\Omni.Desktop.exe --dev",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:materials-ui": "node tests/materials-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  }
}
